rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Fotoğraflar yalnızca izinli hesaplara açık; gerçek liste gizlilik için yalnızca Firebase konsolundaki kurallarda durur
    function photoUser() { return request.auth.token.email_verified == true && request.auth.token.email in ['izinli@ornek.com']; }
    function mem(c) { return /databases/$(database)/documents/clubs/$(c)/members/$(request.auth.uid); }
    function isMember(c) { return signedIn() && exists(mem(c)); }
    function canWrite(c) { return isMember(c) && get(mem(c)).data.role != 'izleyici'; }
    function isOwner(c) { return signedIn() && get(/databases/$(database)/documents/clubs/$(c)).data.ownerId == request.auth.uid; }

    // Kişisel veriler yalnızca sahibine açık; arkadaş aşamasında genişler
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{sub}/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
    // --- Okurlar ve arkadaşlık (2026-11) ---
    // Arkadaşlık: istek kabul edilince karşı taraf, isteğe dayanarak kendini senin listene yazar; iki taraf da arkadaşlıktan çıkabilir
    match /users/{uid}/friends/{fid} {
      allow create: if signedIn() && request.auth.uid == fid && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + fid));
      allow delete: if signedIn() && request.auth.uid == fid;
    }
    // Okur vitrini: giriş yapmış herkes okur, yalnızca sahibi yazar. Sayfa, süre ve hedef alanı kabul edilmez
    match /profiles/{uid} {
      allow read: if signedIn();
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'username', 'nameLower', 'bio', 'four', 'reading', 'updatedAt', 'city', 'age'])
        && request.resource.data.uid == uid && request.resource.data.bio.size() <= 200 && request.resource.data.four.size() <= 4;
    }
    // Arkadaşlık isteği: belge adı gönderen_alan; yalnızca iki taraf görür ve siler
    match /friendRequests/{id} {
      allow read, delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
    }
    // Kitap yorumu: belge adı kitapAnahtarı__uid; giriş yapmış herkes okur, yalnızca sahibi yazar ve siler
    match /reviews/{id} {
      allow read: if signedIn();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.bookKey + '__' + request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5;
    }
    // --- bitiş ---
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /catalog/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() < 300;
    }
    // Davetler listelenemez, yalnızca kodu bilen okuyabilir
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if isOwner(request.resource.data.clubId);
      allow delete: if isOwner(resource.data.clubId);
    }
    match /clubs/{c} {
      allow read: if isMember(c);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /members/{m} {
        allow read: if isMember(c);
        allow create: if signedIn() && m == request.auth.uid && ((request.resource.data.role == 'kurucu' && getAfter(/databases/$(database)/documents/clubs/$(c)).data.ownerId == request.auth.uid) || (request.resource.data.role == 'uye' && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.clubId == c));
        // Kurucu rolleri değiştirir; her üye yalnızca kendi kartını (tek cümle, dört kitap, okunan kitap) günceller
        allow update: if isOwner(c) || (signedIn() && m == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['card']));
        allow delete: if signedIn() && (m == request.auth.uid || isOwner(c));
      }
      match /books/{b} {
        allow read: if isMember(c);
        allow write: if canWrite(c);
        match /notes/{n} {
          allow read: if isMember(c);
          allow write: if canWrite(c);
        }
        match /photos/{p} {
          allow read: if isMember(c);
          allow create: if canWrite(c) && photoUser() && request.resource.data.data.size() < 1000000;
          allow delete: if canWrite(c) && (resource.data.by == request.auth.uid || isOwner(c));
        }
      }
      match /suggestions/{s} {
        allow read: if isMember(c);
        allow write: if canWrite(c);
      }
    }
  }
}

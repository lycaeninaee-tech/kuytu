rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
      // Raf şimdilik yalnızca sahibine açık; arkadaş aşamasında genişler
      match /shelf/{bookId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
    // Kullanıcı adları benzersiz: sahibi oluşturur ve siler, değiştirilemez
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Ortak katalog: üyeler ekler, kimse değiştiremez
    match /catalog/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() < 300;
    }
  }
}
